# ============================================
# Telegram Bot Manager v3.0 — Environment Config
# ============================================

# ─── REQUIRED ───
# Your admin bot token (get from @BotFather)
ADMIN_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# Comma-separated Telegram user IDs of admins (get from @userinfobot)
ADMIN_IDS=8725194109,8156053366

# ─── RENDER WEBHOOK (CRITICAL for 100+ bots) ───
# Your Render app URL — MUST match exactly
WEBHOOK_URL=https://your-app-name.onrender.com

# Flask server settings
PORT=10000
HOST=0.0.0.0

# ─── RATE LIMITING (prevents 429 FloodWait) ───
# Messages per batch before delay
BROADCAST_BATCH_SIZE=30

# Seconds to wait between batches
BROADCAST_DELAY_SEC=1.2

# Max concurrent API calls across ALL bots
API_CALL_SEMAPHORE=50

# Max Bot instances kept in memory (LRU cache)
MAX_CONCURRENT_BOTS=20

# ─── AUTO-RESTART (prevents memory leaks on long runs) ───
AUTO_RESTART_ENABLED=true
AUTO_RESTART_INTERVAL_MIN=60
